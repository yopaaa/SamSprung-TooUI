<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_tile_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#26FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingHorizontal="14dp"
        android:gravity="center_vertical">

        <!-- Drag handle to reorder -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_drag_handle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:padding="4dp"
            app:srcCompat="@drawable/ic_drag_handle_24dp"
            app:tint="?android:textColorSecondary"
            android:contentDescription="Geser urutan" />

        <!-- Feature icon -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_tile"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="14dp"
            app:srcCompat="@drawable/ic_wifi_on_24dp"
            app:tint="?colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_tile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Pintasan"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary" />

            <TextView
                android:id="@+id/text_tile_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Deskripsi singkat fungsi pintasan"
                android:textSize="11.5sp"
                android:textColor="?android:textColorSecondary" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_tile_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="false" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
