<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bottom_sheet_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:orientation="vertical"
        app:behavior_peekHeight="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/fake_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:gravity="bottom|center_horizontal"
            android:orientation="vertical">

            <View
                android:layout_width="wrap_content"
                android:layout_height="4dp"/>
            <View
                android:id="@+id/bottom_handle"
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:background="@color/primary_dark"/>
            <View
                android:layout_width="wrap_content"
                android:layout_height="4dp" />
        </LinearLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/coordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/backgroundFlat"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/blurContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:blurOverlayColor="@android:color/transparent">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/pager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </eightbitlab.com.blurview.BlurView>

                <com.yopa.view.AnimatedLinearLayout
                    android:id="@+id/update_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:gravity="center"
                    android:visibility="invisible"
                    android:background="@color/bottomSheetTint"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/update_icon"
                        app:srcCompat="@drawable/ic_software_update_24"
                        android:layout_width="18dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:contentDescription="@string/description_icon" />
                    <TextView
                        android:id="@+id/update_text"
                        android:layout_width="wrap_content"
                        android:textSize="16sp"
                        android:layout_marginHorizontal="4dp"
                        android:textColor="?android:textColorPrimary"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:layout_height="wrap_content"
                        android:text="@string/update_service" />
                </com.yopa.view.AnimatedLinearLayout>

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/package_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:paddingTop="2dp"
                    android:background="@color/bottomSheetTint"
                    android:lineSpacingExtra="0dp"
                    android:lineSpacingMultiplier="0"
                    android:visibility="gone"
                    android:layout_gravity="bottom"/>
            </FrameLayout>

                <!-- Top Pull-Down Quick Settings Panel (OneUI Style Fullscreen 2 Rows) -->
                <LinearLayout
                    android:id="@+id/top_quick_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="top"
                    android:background="@drawable/quick_panel_bg"
                    android:elevation="20dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp">

                    <!-- Header Row: Title & Close Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pengaturan Cepat"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/button_close"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:padding="3dp"
                            android:background="@drawable/quick_tile_bg"
                            app:tint="@android:color/white"
                            app:srcCompat="@drawable/ic_expand_20dp"
                            android:rotation="180"
                            android:contentDescription="@string/btn_close_tip" />
                    </LinearLayout>

                    <!-- Dynamic 2-Row Horizontal Scrollable Quick Tiles -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_quick_tiles"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:scrollbars="none"
                        android:overScrollMode="never" />

                    <!-- Legacy drag handle (hidden, exit is now via edge gesture) -->
                    <View
                        android:id="@+id/panel_drag_handle"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- Hidden legacy toolbar for safe compatibility -->
                    <androidx.appcompat.widget.Toolbar
                        android:id="@+id/toolbar"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Hidden legacy views for safe backward compatibility -->
                <LinearLayout
                    android:id="@+id/bottom_sheet"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/bottom_info"
                        android:layout_width="0dp"
                        android:layout_height="0dp">
                        <TextView android:id="@+id/battery_status" android:layout_width="0dp" android:layout_height="0dp" />
                        <LinearLayout android:id="@+id/toggle_status" android:layout_width="0dp" android:layout_height="0dp" />
                        <TextClock android:id="@+id/clock_status" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>
                </LinearLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/menu_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:focusable="false"
        android:outlineProvider="none"
        app:srcCompat="@drawable/ic_samsprung_24dp"
        app:backgroundTint="@android:color/transparent"
        app:borderWidth="0dp"
        app:fabSize="mini"
        app:maxImageSize="20dp"
        app:layout_anchor="@+id/bottom_handle"
        app:layout_anchorGravity="top|end"
        app:layout_dodgeInsetEdges="bottom"
        android:layout_marginStart="-6dp"
        android:layout_marginEnd="-6dp"
        android:contentDescription="@string/description_badge"
        app:useCompatPadding="false" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>