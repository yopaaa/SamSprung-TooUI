<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tampilan Layar Cover"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atur rotasi, animasi transisi, waktu layar mati, dan wallpaper cover screen."
            android:textSize="13sp"
            android:textColor="?android:textColorSecondary"
            android:layout_marginBottom="16dp" />

        <!-- Card 1: Rotation -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_rotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#26FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Izinkan Rotasi Layar Cover"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mengikuti sensor orientasi gravitasi pada layar luar Z Flip 4."
                        android:textSize="12sp"
                        android:textColor="?android:textColorSecondary" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_rotation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 1.5: Clock Style Selection -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_clock_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#26FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Style Jam Layar Cover"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pilih gaya tampilan jam pada cover screen (preview terlihat langsung pada wallpaper di bawah)."
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

                <!-- Clock Style Option Cards Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Style 1 (Classic Centered) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_clock_s1"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="#00E676"
                        app:cardBackgroundColor="#222222">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12:00"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white" />

                            <TextView
                                android:id="@+id/tv_clock_label_s1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Style 1\nKlasik"
                                android:gravity="center"
                                android:textSize="9.5sp"
                                android:textColor="#00E676" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Style 2 (Minimalist Left) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_clock_s2"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#26FFFFFF"
                        app:cardBackgroundColor="#1A1A1A">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12:00 •"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-light"
                                android:textStyle="bold"
                                android:textColor="@android:color/white" />

                            <TextView
                                android:id="@+id/tv_clock_label_s2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Style 2\nMinimalis"
                                android:gravity="center"
                                android:textSize="9.5sp"
                                android:textColor="#B3FFFFFF" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Style 3 (Stacked Vertical) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_clock_s3"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#26FFFFFF"
                        app:cardBackgroundColor="#1A1A1A">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12\n00"
                                android:textSize="10.5sp"
                                android:lineSpacingExtra="-4dp"
                                android:textStyle="bold"
                                android:textColor="#00E676" />

                            <TextView
                                android:id="@+id/tv_clock_label_s3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="Style 3\nBertumpuk"
                                android:gravity="center"
                                android:textSize="9.5sp"
                                android:textColor="#B3FFFFFF" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Style 4 (Modern Pill) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_clock_s4"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#26FFFFFF"
                        app:cardBackgroundColor="#1A1A1A">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/rounded_layout_themed"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="1dp"
                                android:text="12:00"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white" />

                            <TextView
                                android:id="@+id/tv_clock_label_s4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Style 4\nModern"
                                android:gravity="center"
                                android:textSize="9.5sp"
                                android:textColor="#B3FFFFFF" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Wallpaper -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#26FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wallpaper Layar Cover"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pilih gambar atau animasi GIF untuk latar belakang cover screen (512×260)."
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

                <!-- Wallpaper Preview Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_wallpaper_preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="#33FFFFFF"
                    app:cardBackgroundColor="#161616">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Preview Image View with centerCrop -->
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_wallpaper_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Pratinjau Wallpaper" />

                        <!-- Empty State Container when no wallpaper set -->
                        <LinearLayout
                            android:id="@+id/layout_wallpaper_empty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="gone"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_wallpaper_24dp"
                                app:tint="#80FFFFFF"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Belum ada wallpaper kustom"
                                android:textSize="12sp"
                                android:textColor="#80FFFFFF" />
                        </LinearLayout>

                        <!-- ============================================== -->
                        <!-- Clock Style Preview Overlays                   -->
                        <!-- ============================================== -->

                        <!-- Style 1 Preview (Classic Centered) -->
                        <LinearLayout
                            android:id="@+id/preview_clock_s1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextClock
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:format12Hour="hh:mm"
                                android:format24Hour="HH:mm"
                                android:textSize="40sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white"
                                android:fontFamily="sans-serif-medium"
                                android:includeFontPadding="false"
                                android:shadowColor="#80000000"
                                android:shadowDy="2"
                                android:shadowRadius="8" />

                            <TextClock
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:format12Hour="EEEE, d MMMM"
                                android:format24Hour="EEEE, d MMMM"
                                android:textSize="9sp"
                                android:textColor="#E6FFFFFF"
                                android:shadowColor="#80000000"
                                android:shadowRadius="4" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:background="@drawable/rounded_layout"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="1dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100%"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/white" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Style 2 Preview (Minimalist Left) -->
                        <LinearLayout
                            android:id="@+id/preview_clock_s2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="20dp"
                            android:visibility="gone"
                            android:orientation="vertical">

                            <TextClock
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:format12Hour="hh:mm"
                                android:format24Hour="HH:mm"
                                android:textSize="34sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white"
                                android:fontFamily="sans-serif-light"
                                android:includeFontPadding="false"
                                android:shadowColor="#99000000"
                                android:shadowRadius="8" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextClock
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:format12Hour="EEE, d MMM"
                                    android:format24Hour="EEE, d MMM"
                                    android:textSize="9sp"
                                    android:textColor="#E6FFFFFF"
                                    android:shadowColor="#80000000"
                                    android:shadowRadius="4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="4dp"
                                    android:text="•"
                                    android:textSize="9sp"
                                    android:textColor="#99FFFFFF" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100%"
                                    android:textSize="8.5sp"
                                    android:textStyle="bold"
                                    android:textColor="#00E676" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Style 3 Preview (Stacked Vertical) -->
                        <LinearLayout
                            android:id="@+id/preview_clock_s3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="20dp"
                            android:gravity="center_vertical"
                            android:visibility="gone"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextClock
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:format12Hour="hh"
                                    android:format24Hour="HH"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/white"
                                    android:fontFamily="sans-serif-black"
                                    android:includeFontPadding="false"
                                    android:shadowColor="#99000000"
                                    android:shadowRadius="6" />

                                <TextClock
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:format12Hour="mm"
                                    android:format24Hour="mm"
                                    android:textSize="28sp"
                                    android:textStyle="bold"
                                    android:textColor="#00E676"
                                    android:fontFamily="sans-serif-black"
                                    android:includeFontPadding="false"
                                    android:shadowColor="#99000000"
                                    android:shadowRadius="6" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextClock
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:format12Hour="EEEE"
                                    android:format24Hour="EEEE"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/white"
                                    android:shadowColor="#80000000"
                                    android:shadowRadius="4" />

                                <TextClock
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="1dp"
                                    android:format12Hour="d MMMM"
                                    android:format24Hour="d MMMM"
                                    android:textSize="8.5sp"
                                    android:textColor="#CCFFFFFF"
                                    android:shadowColor="#80000000"
                                    android:shadowRadius="4" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:background="@drawable/rounded_layout"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1dp"
                                    android:text="100%"
                                    android:textSize="8sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/white" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Style 4 Preview (Modern Pill) -->
                        <LinearLayout
                            android:id="@+id/preview_clock_s4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="gone"
                            android:orientation="vertical">

                            <TextClock
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:format12Hour="EEEE • d MMM"
                                android:format24Hour="EEEE • d MMM"
                                android:textSize="8.5sp"
                                android:textStyle="bold"
                                android:textColor="#00E676"
                                android:shadowColor="#80000000"
                                android:shadowRadius="4" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:background="@drawable/rounded_layout_themed"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="2dp">

                                <TextClock
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:format12Hour="hh:mm"
                                    android:format24Hour="HH:mm"
                                    android:textSize="26sp"
                                    android:textStyle="bold"
                                    android:textColor="@android:color/white"
                                    android:fontFamily="sans-serif-medium"
                                    android:includeFontPadding="false" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Baterai 100%"
                                android:textSize="8sp"
                                android:textColor="#CCFFFFFF"
                                android:shadowColor="#80000000"
                                android:shadowRadius="4" />
                        </LinearLayout>

                        <!-- Cover screen badge tag -->
                        <TextView
                            android:id="@+id/tv_wallpaper_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_circle_button"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Layar Cover (512×260)"
                            android:textSize="10sp"
                            android:textColor="#CCFFFFFF" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_choose_wallpaper"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pilih Wallpaper"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_remove_wallpaper"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hapus Wallpaper"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <!-- Card: Cover Screen DPI / Density -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#26FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kerapatan Layar Cover (DPI)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sesuaikan skala agar aplikasi seperti YouTube, Chrome, dan Instagram tampil proporsional tanpa elemen terpotong/bertumpuk."
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

                <Spinner
                    android:id="@+id/spinner_cover_density"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:spinnerMode="dropdown"
                    android:entries="@array/cover_density_entries" />

                <TextView
                    android:id="@+id/text_density_permission_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:text="⚠️ Butuh izin WRITE_SECURE_SETTINGS via ADB untuk mengubah DPI langsung dari aplikasi."
                    android:textSize="11sp"
                    android:textColor="#FFA726" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copy_density_cmd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:textSize="12sp"
                    android:text="Salin Perintah ADB" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 4: Floating Voice Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_floating_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#26FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tombol Dikte Suara Mengambang"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?android:textColorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Menampilkan tombol mikrofon mengambang saat membuka aplikasi di layar cover untuk mengetik dengan suara dan langsung kirim."
                            android:textSize="12sp"
                            android:textColor="?android:textColorSecondary" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_floating_voice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💡 Tips Offline: Anda dapat mengetik dengan suara 100% tanpa internet jika paket bahasa offline sudah diunduh di Pengaturan HP -> Manajemen Umum -> Voice Typing (Google) -> Pengenalan Suara Offline."
                    android:textSize="11sp"
                    android:textColor="#80D8FF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 5: Screen Timeout -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#26FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Waktu Mati Layar Cover"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:textColorPrimary" />

                    <TextView
                        android:id="@+id/text_timeout_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 menit (Standar)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?colorPrimary" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Durasi layar cover menyala sebelum otomatis mati karena tidak ada aktivitas (berlaku di jam/beranda maupun saat membuka aplikasi)."
                    android:textSize="12sp"
                    android:textColor="?android:textColorSecondary" />

                <SeekBar
                    android:id="@+id/seekbar_timeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:min="15"
                    android:max="300"
                    android:progress="60" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
