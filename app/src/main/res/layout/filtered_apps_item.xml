<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hiddenItemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    android:paddingHorizontal="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/selectableItemBackground">

    <!-- Drag Handle (visible when pinned) -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnDragHandle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:padding="4dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_drag_handle_24dp"
        app:tint="?android:textColorSecondary"
        android:contentDescription="Drag Handle" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hiddenItemImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/description_icon" />

    <TextView
        android:id="@+id/hiddenItemText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="?android:textColorPrimary"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Pin Button -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnPinItem"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:srcCompat="@drawable/ic_pin_outline_24dp"
        app:tint="?android:textColorSecondary"
        android:contentDescription="Pin App" />

    <!-- Hide/Show Switch -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/hiddenItemSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
