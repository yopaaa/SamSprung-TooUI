<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voice_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_margin="8dp"
    android:background="@drawable/bg_voice_dialog"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header: Status, Language Switch, Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/voice_status_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/description_icon"
            app:srcCompat="@drawable/ic_mic_24dp"
            app:tint="#FF5252" />

        <TextView
            android:id="@+id/voice_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mendengarkan..."
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voice_lang_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quick_chip"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="🌐 ID"
            android:textColor="#80D8FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/voice_button_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/description_icon"
            android:padding="2dp"
            app:srcCompat="@drawable/ic_close_24dp"
            app:tint="#BDBDBD" />
    </LinearLayout>

    <!-- Text Input / Transcribed Result -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_voice_input_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <EditText
            android:id="@+id/voice_text_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Katakan pesan Anda..."
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:minLines="1"
            android:textColor="@android:color/white"
            android:textColorHint="#757575"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/voice_button_clear"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/description_icon"
            android:padding="2dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_close_24dp"
            app:tint="#9E9E9E" />
    </LinearLayout>

    <!-- Quick Replies Horizontal ScrollView -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/voice_quick_replies_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- Chips will be populated programmatically or dynamically -->
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Action Buttons: Re-mic, Tempel (Paste), Kirim (Send) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/voice_action_mic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quick_chip"
            android:drawableStart="@drawable/ic_mic_24dp"
            android:drawablePadding="4dp"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="Bicara"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:drawableTint="@android:color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/voice_action_paste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quick_chip"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="📋 Tempel"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/voice_action_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send_button"
            android:drawableEnd="@drawable/ic_send_24dp"
            android:drawablePadding="4dp"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="Kirim"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:drawableTint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
