<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voice_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginHorizontal="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_voice_dialog"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- Mic toggle button (left) -->
    <FrameLayout
        android:id="@+id/voice_mic_container"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_floating_mic"
        android:padding="8dp">

        <ImageView
            android:id="@+id/voice_status_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/description_icon"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_mic_24dp"
            app:tint="#FF5252" />
    </FrameLayout>

    <!-- Center: Live speech text & Status in one compact vertical stack -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/voice_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mendengarkan..."
            android:textColor="#FF5252"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/voice_text_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="Bicara sekarang..."
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLines="2"
            android:padding="0dp"
            android:textColor="@android:color/white"
            android:textColorHint="#888888"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Close button (X) -->
    <ImageView
        android:id="@+id/voice_button_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/description_icon"
        android:padding="6dp"
        app:srcCompat="@drawable/ic_close_24dp"
        app:tint="#9E9E9E" />

    <!-- Send button (Kirim 🚀) -->
    <FrameLayout
        android:id="@+id/voice_button_send_container"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_send_button"
        android:padding="8dp">

        <ImageView
            android:id="@+id/voice_button_send"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/description_icon"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_send_24dp"
            app:tint="@android:color/white" />
    </FrameLayout>
</LinearLayout>
