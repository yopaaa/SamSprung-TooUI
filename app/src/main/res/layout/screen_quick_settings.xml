<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ikon Pengaturan Cepat"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atur tombol aktif dan seret (drag) ikon handle di sebelah kiri untuk mengubah urutan tampilan ikon pada cover screen Z Flip 4."
            android:textSize="13sp"
            android:textColor="?android:textColorSecondary"
            android:layout_marginBottom="14dp" />

        <!-- Info Badge Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?colorPrimary"
            app:cardBackgroundColor="@color/bottomSheetTint">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    app:srcCompat="@drawable/ic_swipe_down_24dp"
                    app:tint="?colorPrimary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Jika mengaktifkan lebih dari 8 ikon, panel pengaturan cepat pada cover screen dapat digeser (swipe horizontal) ke samping."
                    android:textSize="12sp"
                    android:textColor="?android:textColorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reorderable List of Quick Tiles -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_quick_settings_reorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_quick_settings_reorder" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
